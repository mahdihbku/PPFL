diff --git a/util/ppfl_stats.py b/util/ppfl_stats.py
new file mode 100644
index 0000000..772f957
--- /dev/null
+++ b/util/ppfl_stats.py
@@ -0,0 +1,49 @@
+"""Measurement hooks added for the PPFL comparison (no protocol change).
+
+FLAMINGO_STATS_CSV: per-agent CPU-time rows written at kernel stop (their own step timers).
+FLAMINGO_COUNT_BYTES=1: serialized size of every message, measured as in the authors' debug
+logging (dill.dumps with EC points converted to (x, y) integers), accumulated per sender and
+per recipient. Byte counting adds work inside timed steps, so it is used in separate runs.
+"""
+
+import csv
+import os
+from collections import defaultdict
+
+import dill
+
+COUNT_BYTES = os.environ.get("FLAMINGO_COUNT_BYTES") == "1"
+SENT = defaultdict(int)
+RECV = defaultdict(int)
+
+
+def _plain(o):
+    if type(o).__name__ == "EccPoint":
+        return (int(o.x), int(o.y))
+    if isinstance(o, dict):
+        return {(_plain(k) if isinstance(k, tuple) else k): _plain(v) for k, v in o.items()}
+    if isinstance(o, (list, tuple)):
+        return type(o)(_plain(v) for v in o)
+    return o
+
+
+def count(sender, recipient, body):
+    if not COUNT_BYTES:
+        return
+    n = len(dill.dumps(_plain(body)))
+    SENT[sender] += n
+    RECV[recipient] += n
+
+
+def write_row(row):
+    path = os.environ.get("FLAMINGO_STATS_CSV")
+    if not path:
+        return
+    if COUNT_BYTES:
+        row = dict(row, bytes_sent=SENT[row["id"]], bytes_recv=RECV[row["id"]])
+    new = not os.path.exists(path)
+    with open(path, "a", newline="") as fh:
+        w = csv.DictWriter(fh, fieldnames=list(row))
+        if new:
+            w.writeheader()
+        w.writerow(row)
